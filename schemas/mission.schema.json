{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artixcore/ants/schemas/mission.schema.json",
  "title": "Ants Mission",
  "description": "Top-level contract for an Ants investigation mission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "title",
    "objective",
    "mode",
    "scope",
    "permissions",
    "budgets",
    "stopConditions",
    "reporting",
    "requestedBy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "missionId": {
      "type": "string",
      "pattern": "^mis_[A-Za-z0-9_-]{8,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "mode": {
      "type": "string",
      "enum": ["read-only", "propose", "controlled-action"]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "permissions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "stopConditions": {
      "$ref": "#/$defs/stopConditions"
    },
    "reporting": {
      "$ref": "#/$defs/reporting"
    },
    "requestedBy": {
      "$ref": "#/$defs/requestedBy"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "knownFacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "initialHypotheses": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "retentionDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "providerPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "preferLocal": {
          "type": "boolean"
        },
        "maximumTier": {
          "type": "string",
          "enum": ["economy", "standard", "reasoning", "reporting", "local-sensitive"]
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "include", "exclude"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "development", "staging", "production", "mixed"]
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "timeRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "operation", "scope"],
      "properties": {
        "resourceType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "operation": {
          "type": "string",
          "enum": ["discover", "read", "analyze", "propose", "write", "execute", "delete"]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "maxTasks", "maxToolCalls", "maxModelTokens", "maxEstimatedCostUsd"],
      "properties": {
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "maxTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxTaskDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maxModelTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "maxEstimatedCostUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxBytesRead": {
          "type": "integer",
          "minimum": 0
        },
        "maxRetriesPerTask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "stopConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredIndependentValidations", "maxNoProgressTasks", "completeWhenDefensible"],
      "properties": {
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requiredIndependentValidations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxNoProgressTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "completeWhenDefensible": {
          "type": "boolean"
        },
        "pauseOnSecretDetection": {
          "type": "boolean"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "includeEvidenceIndex", "includeContradictions", "includeLimitations"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "markdown", "markdown+json"]
        },
        "includeEvidenceIndex": {
          "type": "boolean"
        },
        "includeContradictions": {
          "type": "boolean"
        },
        "includeLimitations": {
          "type": "boolean"
        }
      }
    },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "service", "schedule", "alert", "test"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
