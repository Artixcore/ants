{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artixcore/ants/schemas/tool-call.schema.json",
  "title": "Ants Tool Call",
  "description": "Authorized request envelope for a Tool Gateway operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolCallId",
    "missionId",
    "taskId",
    "agentRunId",
    "toolId",
    "operation",
    "target",
    "arguments",
    "idempotencyKey",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "toolCallId": {
      "type": "string",
      "pattern": "^call_[A-Za-z0-9_-]{8,128}$"
    },
    "missionId": {
      "type": "string",
      "pattern": "^mis_[A-Za-z0-9_-]{8,128}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
    },
    "agentRunId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "operation": {
      "type": "string",
      "enum": ["discover", "read", "analyze", "propose", "write", "execute", "delete"]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "arguments": {
      "type": "object"
    },
    "riskClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "approvalTokenRef": {
      "type": "string",
      "maxLength": 512
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
