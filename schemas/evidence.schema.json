{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artixcore/ants/schemas/evidence.schema.json",
  "title": "Ants Evidence",
  "description": "Immutable observation with source provenance and integrity metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "missionId",
    "type",
    "source",
    "collector",
    "collectedAt",
    "content",
    "contentHash",
    "integrity",
    "sensitivity",
    "independenceGroup"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"
    },
    "missionId": {
      "type": "string",
      "pattern": "^mis_[A-Za-z0-9_-]{8,128}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
    },
    "agentRunId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "log",
        "metric",
        "file",
        "git",
        "process",
        "system",
        "database",
        "cloud",
        "ci",
        "network",
        "test-result",
        "security",
        "user-provided",
        "derived",
        "other"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "collector": {
      "$ref": "#/$defs/collector"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "uncertaintySeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "inline"
            },
            "value": {
              "type": ["string", "number", "boolean", "object", "array", "null"]
            },
            "format": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri"],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "format": {
              "type": "string",
              "maxLength": 100
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512", "blake3"]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{32,128}$"
        }
      }
    },
    "integrity": {
      "type": "string",
      "enum": ["verified", "captured", "partial", "untrusted", "invalidated"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted", "secret-detected"]
    },
    "independenceGroup": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceReliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "parentEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "parametersHash": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "removedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "resourceId": {
          "type": "string",
          "maxLength": 2048
        },
        "location": {
          "type": "string",
          "maxLength": 2048
        },
        "lineRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "toolVersion", "toolCallId"],
      "properties": {
        "toolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "toolCallId": {
          "type": "string",
          "pattern": "^call_[A-Za-z0-9_-]{8,128}$"
        }
      }
    }
  }
}
