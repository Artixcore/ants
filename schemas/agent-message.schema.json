{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artixcore/ants/schemas/agent-message.schema.json",
  "title": "Ants Agent Message",
  "description": "Versioned command or event envelope used across Ants components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "messageType",
    "missionId",
    "correlationId",
    "producer",
    "createdAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{8,128}$"
    },
    "messageType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "missionId": {
      "type": "string",
      "pattern": "^mis_[A-Za-z0-9_-]{8,128}$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "causationId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{8,128}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "agentRunId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
