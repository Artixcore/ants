{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artixcore/ants/schemas/hypothesis.schema.json",
  "title": "Ants Hypothesis",
  "description": "Testable explanation with support, contradictions, validation, and confidence rationale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hypothesisId",
    "missionId",
    "statement",
    "status",
    "supportEvidenceIds",
    "contradictionEvidenceIds",
    "independenceGroups",
    "confidence",
    "missingEvidence",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "hypothesisId": {
      "type": "string",
      "pattern": "^hyp_[A-Za-z0-9_-]{8,128}$"
    },
    "missionId": {
      "type": "string",
      "pattern": "^mis_[A-Za-z0-9_-]{8,128}$"
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "investigating",
        "validation-required",
        "supported",
        "partially-supported",
        "refuted",
        "inconclusive",
        "reported"
      ]
    },
    "proposedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "agentRunId"],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
        },
        "agentRunId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "supportEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5000,
      "items": {
        "type": "string",
        "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"
      }
    },
    "contradictionEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5000,
      "items": {
        "type": "string",
        "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"
      }
    },
    "independenceGroups": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "factors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidenceStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "independence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reproduction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "temporalRelevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "contradictionPenalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "predictedObservations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "falsificationCriteria": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "alternativeHypothesisIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^hyp_[A-Za-z0-9_-]{8,128}$"
      }
    },
    "validations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "affectedEntityIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validationId",
        "agentRunId",
        "outcome",
        "evidenceIds",
        "independenceGroup",
        "rationale",
        "completedAt"
      ],
      "properties": {
        "validationId": {
          "type": "string",
          "pattern": "^val_[A-Za-z0-9_-]{8,128}$"
        },
        "agentRunId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
        },
        "outcome": {
          "type": "string",
          "enum": ["supported", "partially-supported", "refuted", "inconclusive", "not-attempted"]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[A-Za-z0-9_-]{8,128}$"
          }
        },
        "independenceGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
