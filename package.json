{
  "name": "@artixcore/ants",
  "version": "0.3.1",
  "description": "A security-hardened read-only local incident-investigation engine for Node.js services.",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "ants": "./src/cli.js"
  },
  "scripts": {
    "start": "node ./src/cli.js",
    "dev": "node --watch ./src/cli.js",
    "lint": "node ./scripts/check-syntax.js",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "demo": "node ./src/cli.js demo",
    "security:audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artixcore/ants.git"
  },
  "homepage": "https://github.com/Artixcore/ants#readme",
  "bugs": {
    "url": "https://github.com/Artixcore/ants/issues"
  },
  "author": {
    "name": "Ismam Tabriz Shams",
    "url": "https://artixcore.com/founder"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "ai-agents",
    "cloud",
    "devops",
    "incident-response",
    "multi-agent",
    "nodejs",
    "sre"
  ]
}
